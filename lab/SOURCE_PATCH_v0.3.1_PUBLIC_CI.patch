diff --git a/src/utils/windows-direct-spawn.ts b/src/utils/windows-direct-spawn.ts
new file mode 100644
index 0000000..7123464
--- /dev/null
+++ b/src/utils/windows-direct-spawn.ts
@@ -0,0 +1,106 @@
+import path from 'path';
+
+/**
+ * Conservative, stateless planning for Windows one-process launches.
+ *
+ * The caller MUST keep validating the original command against blockedCommands
+ * BEFORE using this result. A null result means preserving the existing shell
+ * wrapper, not rejecting the user's command or changing its interpretation.
+ *
+ * Windows-specific handling is explicit so the planner itself can be tested
+ * on Linux; this does NOT simulate Windows process or window behavior.
+ */
+export interface WindowsDirectSpawn {
+  executable: string;
+  args: string[];
+  windowsVerbatim: boolean;
+  reason: 'same-shell' | 'explicit-native-exe';
+}
+
+const SAFE_WORD = /^[A-Za-z0-9_.:\/\\-]+$/;
+const UNSAFE_EXECUTABLE = /["'`$;|&<>(){}\[\]!%\u0000-\u001f]/;
+const NATIVE_SHELLS = new Set(['powershell', 'pwsh', 'cmd']);
+
+/**
+ * Only an unquoted literal executable token followed by
+ * zero or more simple words. No redirection, pipelines, variable expansion,
+ * quotes in arguments, CR/LF, command substitution, or shell metacharacters.
+ *
+ * Quoted executable paths are deliberately excluded: the upstream command
+ * validator cannot reliably identify an executable inside a quoted path
+ * containing spaces, so optimizing it could bypass blockedCommands.
+ */
+export function parseLiteralWindowsInvocation(command: string): { executable: string; args: string[] } | null {
+  if (/[\r\n]/.test(command)) return null;
+  const text = command.trim();
+  if (!text) return null;
+
+  // Require a fully unquoted executable: preserves the existing command
+  // validator semantics even for disallowed binaries in paths with spaces.
+  const firstSpace = text.search(/\s/);
+  const executable = firstSpace === -1 ? text : text.slice(0, firstSpace);
+  const rest = firstSpace === -1 ? '' : text.slice(firstSpace);
+
+  if (!executable || UNSAFE_EXECUTABLE.test(executable)) return null;
+  // No quotes or whitespace are interpreted as executable/argument syntax.
+  const argsText = rest.trim();
+  const args = argsText ? argsText.split(/\s+/) : [];
+  if (!args.every(arg => SAFE_WORD.test(arg))) return null;
+  if (!argsText && rest && !/^\s*$/.test(rest)) return null;
+  return { executable, args };
+}
+
+/**
+ * Compare canonical Windows path strings without relying on the test host OS.
+ * Resolution and existence checks are intentionally injected from the caller;
+ * the adapter must only return existing executable files, never an arbitrary
+ * unverified name or .cmd/.bat script.
+ */
+function sameResolvedWindowsExecutable(a: string, b: string): boolean {
+  return path.win32.normalize(a).toLowerCase() === path.win32.normalize(b).toLowerCase();
+}
+
+export function planWindowsDirectSpawn(
+  command: string,
+  configuredExecutable: string,
+  resolveExistingExecutable: (requested: string) => string | null,
+  windowsHost: boolean,
+): WindowsDirectSpawn | null {
+  if (!windowsHost) return null;
+  const parsed = parseLiteralWindowsInvocation(command);
+  if (!parsed) return null;
+
+  const invokedBase = path.win32.basename(parsed.executable).toLowerCase();
+  const configuredBase = path.win32.basename(configuredExecutable).toLowerCase().replace(/\.exe$/, '');
+  const invokedBare = invokedBase.replace(/\.exe$/, '');
+  // Do not reinterpret commands under Bash, Fish, custom shells or WSL.
+  if (!NATIVE_SHELLS.has(configuredBase)) return null;
+  const isConfiguredShell = invokedBare === configuredBase;
+
+  // Avoid changing PowerShell cmdlet/alias semantics for bare programs. Only
+  // explicit .exe command names have the optional direct-native execution path.
+  const isExplicitExe = /\.exe$/i.test(invokedBase);
+  if (!isConfiguredShell && !isExplicitExe) return null;
+
+  let resolved: string | null;
+  try {
+    resolved = resolveExistingExecutable(parsed.executable);
+  } catch {
+    return null;
+  }
+  if (!resolved || !path.win32.isAbsolute(resolved) || !/\.exe$/i.test(resolved)) return null;
+
+  if (isConfiguredShell && !sameResolvedWindowsExecutable(resolved, configuredExecutable)) {
+    // A different executable with the same name must not impersonate the
+    // configured shell; leave its exact invocation to the established parser.
+    return null;
+  }
+  // For explicit .exe commands the resolver must verify the file exists.
+  // In particular never direct-spawn .bat/.cmd or a PowerShell function name.
+  return {
+    executable: resolved,
+    args: parsed.args,
+    windowsVerbatim: path.win32.basename(resolved).toLowerCase() === 'cmd.exe',
+    reason: isConfiguredShell ? 'same-shell' : 'explicit-native-exe',
+  };
+}
diff --git a/src/utils/windows-headless-broker.ts b/src/utils/windows-headless-broker.ts
new file mode 100644
index 0000000..a2ca5e9
--- /dev/null
+++ b/src/utils/windows-headless-broker.ts
@@ -0,0 +1,108 @@
+import fs from 'fs';
+import path from 'path';
+
+/**
+ * EXPERIMENTAL - must NOT be enabled on a production workstation until
+ * independently verified in a Windows GUI lab. The environment variable
+ * DC_WINDOWS_HEADLESS_BROKER is the opt-in flag (literal "1").
+ *
+ * This planner is deliberately pure for isolated non-Windows tests. It only
+ * builds the transport arguments; it does not create a Windows desktop itself.
+ */
+export interface BrokerSpawnConfig {
+  executable: string;
+  args: string[];
+  windowsVerbatim?: boolean;
+  useShellOption: string | boolean;
+}
+
+export interface BrokerPayload {
+  protocol: 1;
+  executable: string;
+  args: string[];
+  verbatim: boolean;
+  killTree?: boolean;
+}
+
+/** Shell payload uses -EncodedCommand only *inside* the optional desktop broker.
+ * This preserves the exact UTF-16 code units of multiline PowerShell text,
+ * rather than reparsing newline boundaries as argv. The original plain text
+ * remains available to Desktop Commander's pre-spawn command validator/logs.
+ */
+export function encodeMultilinePowerShell(
+  configuredShell: string,
+  script: string,
+  isWindows: boolean,
+): string[] | null {
+  const base = path.win32.basename(configuredShell).toLowerCase();
+  if (!isWindows || !['powershell', 'powershell.exe', 'pwsh', 'pwsh.exe'].includes(base)) return null;
+  if (!/[\r\n]/.test(script)) return null;
+  if (script.includes('\u0000')) return null;
+  const encoded = Buffer.from(script, 'utf16le').toString('base64');
+  // `CreateProcessW` command line is limited to 32,767 UTF-16 code units;
+  // leave ample room for the broker's Base64 JSON envelope and path.
+  if (encoded.length > 15000) return null;
+  return ['-EncodedCommand', encoded];
+}
+
+/** Wrap an existing (already-validated) Windows spawn plan in a broker.
+ * Refuse invalid/missing broker binaries; do not silently fall back to a
+ * possibly visible PowerShell window after the owner opted in to containment.
+ * Returns null when disabled or when the OS is not Windows.
+ */
+export function planHeadlessBroker(
+  original: BrokerSpawnConfig,
+  brokerPath: string,
+  enabled: boolean,
+  isWindows: boolean,
+  fileExists: (p: string) => boolean = fs.existsSync,
+  killTree = false,
+): BrokerSpawnConfig | null {
+  if (!isWindows || !enabled) return null;
+  if (typeof brokerPath !== 'string' || !path.win32.isAbsolute(brokerPath) || !/\.exe$/i.test(brokerPath)) {
+    throw new Error('FOTOMAG_HEADLESS_BROKER_INVALID_PATH');
+  }
+  if (!fileExists(brokerPath)) throw new Error('FOTOMAG_HEADLESS_BROKER_NOT_INSTALLED');
+  if (original.useShellOption !== false) throw new Error('FOTOMAG_HEADLESS_BROKER_SHELL_FALLBACK_UNSUPPORTED');
+  if (!path.win32.isAbsolute(original.executable) || !/\.exe$/i.test(original.executable)) {
+    throw new Error('FOTOMAG_HEADLESS_TARGET_MUST_BE_VERIFIED_EXE');
+  }
+  const payload: BrokerPayload = {
+    protocol: 1,
+    executable: original.executable,
+    args: [...original.args],
+    verbatim: original.windowsVerbatim === true,
+    killTree,
+  };
+  const argv64 = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
+  if (argv64.length > 24000) throw new Error('FOTOMAG_HEADLESS_BROKER_PAYLOAD_TOO_LONG');
+  return { executable: brokerPath, args: [argv64], useShellOption: false, windowsVerbatim: false };
+}
+
+/**
+ * Build the optional plan without touching server configuration. Default is
+ * deliberately OFF, so existing v0.3.1 behavior is preserved until an
+ * independent Windows GUI machine demonstrates safety and compatibility.
+ */
+export function optionalHeadlessBroker(
+  original: BrokerSpawnConfig,
+  configuredShellPath: string,
+  originalCommand: string,
+  windowsHost: boolean,
+  env: NodeJS.ProcessEnv = process.env,
+  fileExists: (p: string) => boolean = fs.existsSync,
+): BrokerSpawnConfig {
+  if (!windowsHost || env.DC_WINDOWS_HEADLESS_BROKER !== '1') return original;
+  const nativeShell = path.win32.basename(configuredShellPath).toLowerCase().replace(/\.exe$/, '');
+  if (!['powershell', 'pwsh', 'cmd'].includes(nativeShell)) {
+    throw new Error('FOTOMAG_HEADLESS_BROKER_NATIVE_SHELL_ONLY');
+  }
+  let selected = original;
+  // For multiline PowerShell commands, avoid cmdline metachar/quote changes;
+  // do not create another shell; pass the exact script as UTF-16LE Base64.
+  const encoded = encodeMultilinePowerShell(configuredShellPath, originalCommand, windowsHost);
+  if (encoded && path.win32.basename(original.executable).toLowerCase() === path.win32.basename(configuredShellPath).toLowerCase()) {
+    selected = { ...original, args: encoded };
+  }
